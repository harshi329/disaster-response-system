SECRET_KEY=change-me-to-a-random-string
MONGO_URI=mongodb://localhost:27017/disaster_response

# Groq AI — get free key at https://console.groq.com
GROQ_API_KEY=

# Gmail OTP — steps:
# 1. myaccount.google.com → Security → 2-Step Verification → App Passwords
# 2. Create app password → copy 16-char key (no spaces)
MAIL_EMAIL=yourgmail@gmail.com
MAIL_PASSWORD=your16charapppassword

# OpenWeatherMap — get free key at https://openweathermap.org/api
OPENWEATHER_APIKEY=

# Google OAuth — get credentials at https://console.cloud.google.com
# Steps:
# 1. Create a project → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 2. Application type: Web application
# 3. Authorised redirect URI: http://localhost:5000/login/google/callback
# 4. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenRouteService — real GPS routing for the route agent
# Get a free key at https://openrouteservice.org/dev/#/signup
# Free tier: 2,000 requests/day
# Without this key the route agent falls back to a static heuristic — app still works
OPENROUTESERVICE_API_KEY=
